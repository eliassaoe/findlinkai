[
    {
        "name": "input_data",
        "type": "text",
        "label": "LinkedIn Company Page URL",
        "required": true,
        "help": "A LinkedIn company page URL. For example: https://www.linkedin.com/company/tesla-motors"
    },
    {
        "name": "department",
        "type": "text",
        "label": "Department",
        "required": false,
        "help": "Only return employees in this department, e.g. Engineering."
    },
    {
        "name": "seniority",
        "type": "text",
        "label": "Seniority",
        "required": false,
        "help": "Only return employees at this seniority, e.g. Director."
    },
    {
        "name": "employee_count",
        "type": "number",
        "label": "Max Employees",
        "required": false,
        "help": "Cap how many employees come back. Billed 0.5 credits each.",
        "validate": {
            "min": 1
        }
    }
]
