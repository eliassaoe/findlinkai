[
    {
        "url": "/",
        "method": "POST",
        "body": {
            "type": "linkedin_company_to_employees",
            "input_data": "{{parameters.input_data}}",
            "department": "{{parameters.department}}",
            "seniority": "{{parameters.seniority}}",
            "employee_count": "{{parameters.employee_count}}"
        },
        "response": {
            "temp": {
                "jobId": "{{body.job_id}}",
                "result": "{{body.result}}",
                "pending": "{{if(body.job_id, true, false)}}"
            }
        }
    },
    {
        "condition": "{{temp.pending}}",
        "url": "/status/{{temp.jobId}}",
        "method": "GET",
        "repeat": {
            "condition": "{{body.status = \"processing\"}}",
            "delay": 2000,
            "limit": 20
        },
        "response": {
            "error": {
                "404": {
                    "message": "That LinkFinder AI job was not found. Job results expire 10 minutes after they finish."
                }
            },
            "temp": {
                "result": "{{if(body.data, body.data.result, body.result)}}"
            }
        }
    },
    {
        "response": {
            "iterate": "{{temp.result}}",
            "output": "{{item}}"
        }
    }
]
