    {
        "name": "name",
        "type": "text",
        "label": "Full Name",
        "required": true,
        "help": "The person's full name. Enter it as \"First Last\" — unlike the other platforms, Make cannot reorder \"Doe, John\" for you. For example: Bill Gates"
    },
    {
        "name": "company",
        "type": "text",
        "label": "Company",
        "required": false,
        "help": "Where they work. Much the strongest signal after the name. Optional and free — it costs no extra credits and narrows the match. For example: Microsoft"
    },
    {
        "name": "location",
        "type": "text",
        "label": "Location",
        "required": false,
        "help": "City, region or country. Separates people who share a name. Optional and free — it costs no extra credits and narrows the match. For example: Seattle"
    },
    {
        "name": "job_title",
        "type": "text",
        "label": "Job Title",
        "required": false,
        "help": "Their role. Helps when a company has several people with the same name. Optional and free — it costs no extra credits and narrows the match. For example: Co-chair"
    }
]
