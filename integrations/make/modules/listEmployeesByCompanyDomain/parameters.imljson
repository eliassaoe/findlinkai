[
    {
        "name": "input_data",
        "type": "text",
        "label": "Company Domain",
        "required": true,
        "help": "The company's domain, not its name — tesla.com, not Tesla. For example: tesla.com"
    },
    {
        "name": "department",
        "type": "text",
        "label": "Department",
        "required": false,
        "help": "Only return employees in this department, e.g. Engineering."
    },
    {
        "name": "seniority",
        "type": "text",
        "label": "Seniority",
        "required": false,
        "help": "Only return employees at this seniority, e.g. Director."
    },
    {
        "name": "employee_count",
        "type": "number",
        "label": "Max Employees",
        "required": false,
        "help": "Cap how many employees come back. Billed 0.5 credits each.",
        "validate": {
            "min": 1
        }
    }
]
