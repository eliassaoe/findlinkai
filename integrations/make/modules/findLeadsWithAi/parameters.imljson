[
    {
        "name": "input_data",
        "type": "text",
        "label": "Describe the Leads You Want",
        "required": true,
        "help": "Plain English — job titles, industry, company size, location. For example: VP Sales at B2B SaaS startups in the United States"
    },
    {
        "name": "fetch_count",
        "type": "number",
        "label": "Number of Leads",
        "required": false,
        "help": "How many leads to return.",
        "default": 10,
        "validate": {
            "min": 1,
            "max": 100
        }
    }
]
