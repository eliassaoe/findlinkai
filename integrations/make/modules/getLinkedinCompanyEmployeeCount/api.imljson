[
    {
        "url": "/",
        "method": "POST",
        "body": {
            "type": "linkedin_company_to_employee_count",
            "input_data": "{{parameters.input_data}}"
        },
        "response": {
            "temp": {
                "jobId": "{{body.job_id}}",
                "result": "{{body.result}}",
                "pending": "{{if(body.job_id, true, false)}}"
            }
        }
    },
    {
        "condition": "{{temp.pending}}",
        "url": "/status/{{temp.jobId}}",
        "method": "GET",
        "repeat": {
            "condition": "{{body.status = \"processing\"}}",
            "delay": 2000,
            "limit": 20
        },
        "response": {
            "error": {
                "404": {
                    "message": "That LinkFinder AI job was not found. Job results expire 10 minutes after they finish."
                }
            },
            "temp": {
                "result": "{{if(body.data, body.data.result, body.result)}}"
            }
        }
    },
    {
        "response": {
            "output": {
                "employee_count": "{{temp.result}}",
                "value": "{{temp.result}}"
            }
        }
    }
]
