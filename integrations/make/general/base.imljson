{
    "baseUrl": "https://api.linkfinderai.com",
    "headers": {
        "Authorization": "Bearer {{connection.apiKey}}",
        "Content-Type": "application/json"
    },
    "response": {
        "error": {
            "401": {
                "message": "Your LinkFinder AI API key was rejected. Reconnect the connection."
            },
            "402": {
                "message": "Your LinkFinder AI account is out of credits. Top up at linkfinderai.com, then run this scenario again."
            },
            "422": {
                "message": "[422] {{body.message}}"
            },
            "429": {
                "message": "LinkFinder AI rate limit reached. Lower the scenario throughput or retry shortly."
            },
            "message": "[{{statusCode}}] {{body.message}}"
        }
    }
}
