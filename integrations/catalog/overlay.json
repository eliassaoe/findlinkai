    "person": {
      "label": "People",
      "order": 1
    },
    "company": {
      "label": "Companies",
      "order": 2
    },
    "social": {
      "label": "Social",
      "order": 3
    },
    "discovery": {
      "label": "Discovery",
      "order": 4
    }
  },
  "params": {
    "department": {
      "label": "Department",
      "type": "string",
      "help": "Only return employees in this department, e.g. Engineering."
    },
    "seniority": {
      "label": "Seniority",
      "type": "string",
      "help": "Only return employees at this seniority, e.g. Director."
    },
    "employee_count": {
      "label": "Max Employees",
      "type": "integer",
      "min": 1,
      "help": "Cap how many employees come back. Billed 0.5 credits each."
    }
  },
  "operations": {
    "lead_full_name_to_linkedin_url": {
      "key": "findLinkedinUrlFromName",
      "label": "Find LinkedIn URL from Name",
      "category": "person",
      "inputLabel": "Full Name and Company",
      "inputHelp": "The person's full name and their company, in one string.",
      "params": [],
      "output": {
        "kind": "scalar",
        "field": "linkedin_url",
        "sample": "https://www.linkedin.com/in/williamhgates"
      },
      "n8n": {
        "resource": "lead",
        "operation": "fullNameToLinkedinUrl",
        "name": "Full Name → LinkedIn URL",
        "description": "Find a person's LinkedIn URL from their name and company",
        "action": "Find linked in url from full name"
      },
      "compositeInput": {
        "parts": [
          {
            "name": "name",
            "label": "Full Name",
            "required": true,
            "help": "The person's full name. \"Doe, John\" is flipped to \"John Doe\" automatically.",
            "example": "Bill Gates"
          },
          {
            "name": "company",
            "label": "Company",
            "required": false,
            "help": "Where they work. Much the strongest signal after the name.",
            "example": "Microsoft"
          },
          {
            "name": "location",
            "label": "Location",
            "required": false,
            "help": "City, region or country. Separates people who share a name.",
            "example": "Seattle"
          },
          {
            "name": "job_title",
            "label": "Job Title",
            "required": false,
            "help": "Their role. Helps when a company has several people with the same name.",
            "example": "Co-chair"
          }
        ],
        "joinWith": " ",
        "note": "Joined with single spaces, empty parts dropped — the same string app.html builds."
      }
    },
