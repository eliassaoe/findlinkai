{
  "name": "linkfinderai-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for LinkFinder AI — call company/LinkedIn/Instagram lookups and AI lead search from Claude, ChatGPT, or any MCP-compatible client.",
  "type": "module",
  "bin": {
    "linkfinderai-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "MCP_TRANSPORT=http node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "linkfinder-ai",
    "claude",
    "chatgpt"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
