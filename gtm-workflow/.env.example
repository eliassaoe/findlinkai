# ---------------------------------------------------------------------------
# GTM signal engine — environment
#
# n8n reads these with {{ $env.NAME }}. On a self-hosted instance put them in the
# n8n process environment (docker-compose `environment:`, or the systemd unit) —
# NOT in this file, which is only the local reference and the memory service's
# own environment.
#
# n8n must also allow expression access to env vars:
#   N8N_BLOCK_ENV_ACCESS_IN_NODE=false      (this is the default)
# ---------------------------------------------------------------------------

# --- Memory service (config.json + campaign_memory.db over HTTP) ------------
MEMORY_SERVICE_URL=http://127.0.0.1:8787
MEMORY_SERVICE_HOST=127.0.0.1
MEMORY_SERVICE_PORT=8787
# Leave empty to run unauthenticated on localhost. Set it if n8n is on another
# host; the same value goes in the n8n environment.
MEMORY_SERVICE_TOKEN=
# Optional overrides — both default to this directory.
CAMPAIGN_MEMORY_DB=./campaign_memory.db
GTM_CONFIG_PATH=./config.json

# --- Trigify.io (inbound intent signals) ------------------------------------
# Shared secret Trigify sends as the `x-webhook-secret` header on its HTTP
# Request action. The workflow rejects any signal without it.
TRIGIFY_WEBHOOK_SECRET=change-me-trigify

# --- Findymail (discovery + verification) -----------------------------------
FINDYMAIL_API_KEY=
FINDYMAIL_API_BASE=https://app.findymail.com/api

# --- Deliveryman.ai (managed pre-warmed sending) ----------------------------
# NOTE: Deliveryman.ai does not publish its API reference openly. The base URL,
# path and body field names below are the workflow's defaults and are the ONE
# thing you must confirm against your own account's API docs before going live.
# Everything is parameterised so confirming them is an env change, not an edit.
DELIVERYMAN_API_KEY=
DELIVERYMAN_API_BASE=https://api.deliveryman.ai/v1
DELIVERYMAN_SEND_PATH=/emails
DELIVERYMAN_CAMPAIGN_ID=
# Named inbox pool to send from; leave empty to let Deliveryman pick.
DELIVERYMAN_INBOX_POOL=
# Shared secret Deliveryman sends back on the reply webhook.
DELIVERYMAN_WEBHOOK_SECRET=change-me-deliveryman

# --- Model provider ---------------------------------------------------------
# Credentials for the model are configured as an n8n credential, not here.
# ANTHROPIC_API_KEY / DEEPSEEK_API_KEY are only needed if you drive the model
# from your own code rather than through the n8n credential store.
