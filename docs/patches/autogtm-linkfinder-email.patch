diff --git a/migrations/20260906_email_provenance.sql b/migrations/20260906_email_provenance.sql
new file mode 100644
index 0000000..db698c0
--- /dev/null
+++ b/migrations/20260906_email_provenance.sql
@@ -0,0 +1,29 @@
+-- Email provenance for the Autopilot gate.
+--
+-- Upstream AutoGTM has no pre-send email verification: ai/extractEmail.ts asks an LLM
+-- to pull an address out of scraped Exa text, and Autopilot then sends to it. These
+-- columns record where each address came from so automation can refuse to send to a
+-- guess. See packages/autogtm-core/src/ai/resolveEmail.ts.
+
+alter table leads
+  add column if not exists email_source text
+    check (email_source in ('existing','linkfinder_linkedin','linkfinder_name','llm_guess','none')),
+  add column if not exists email_verified boolean not null default false,
+  add column if not exists email_credits_spent integer not null default 0;
+
+comment on column leads.email_source is
+  'Where the address came from. linkfinder_* are resolved; llm_guess is a scrape.';
+comment on column leads.email_verified is
+  'True only for LinkFinder-resolved addresses. getEligibleLeadsForAutoAdd() requires it.';
+comment on column leads.email_credits_spent is
+  'LinkFinder credits spent resolving this lead (10 per LinkedIn lookup, 7 per name).';
+
+-- Autopilot filters on this pair; keep the sweep cheap.
+create index if not exists leads_autoadd_verified_idx
+  on leads (suggested_campaign_id, email_verified, promotion_fit_score desc);
+
+-- Existing rows predate verification. Default false already blocks them from
+-- Autopilot; label them so the UI can explain why.
+update leads
+   set email_source = 'llm_guess'
+ where email is not null and email <> '' and email_source is null;
