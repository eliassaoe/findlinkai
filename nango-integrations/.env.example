# Nango secret key for the environment you're deploying to (dev or prod).
# Find it at https://app.nango.dev/dev/environment-settings
#
# This file is committed. Put a PLACEHOLDER here, never a real key - the
# repository is public, so anything written here is published. Keep the real
# value in .env (gitignored) or your shell environment.
NANGO_SECRET_KEY=<your-nango-secret-key>
