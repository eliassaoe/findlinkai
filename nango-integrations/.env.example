# Authenticates the Nango CLI. Get these from the dashboard's Environment
# Settings: https://app.nango.dev/dev/environment-settings
#
# NOTE the _DEV / _PROD suffixes. The CLI reads these two names specifically -
# a plain NANGO_SECRET_KEY is ignored and every command fails as unauthenticated.
#
# This file is COMMITTED and the repository is public, so put placeholders here
# and nothing else. Real values belong in .env, which is gitignored.
NANGO_SECRET_KEY_DEV=<your-nango-dev-secret-key>
NANGO_SECRET_KEY_PROD=<your-nango-prod-secret-key>

# Self-hosting only - point the CLI at your instance.
# NANGO_HOSTPORT=http://localhost:3003
