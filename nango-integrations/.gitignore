.env
.env.local
node_modules/
dist/

# Nango CLI build output and generated schema. The .nango FOLDER itself must
# stay tracked - the CLI treats its presence as "this is a Nango project", so a
# clone without it fails every command with "Not inside a Nango folder". Ignore
# the contents, keep the marker.
build/
.nango/*
!.nango/.gitkeep
