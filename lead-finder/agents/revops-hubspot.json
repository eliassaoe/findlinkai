{
  "id": "revops-hubspot",
  "label": "RevOps / Sales Ops at HubSpot shops — the CRM audit campaign's ICP",
  "note": "Sources are examples. Replace the post URLs with posts from the last two weeks before a live run — engagement on a six-month-old post is not intent.",
  "icp": {
    "titles": {
      "include": [
        "revops", "revenue operations", "sales operations", "sales ops",
        "head of sales", "vp sales", "vp of sales", "director of sales",
        "head of growth", "demand generation", "gtm"
      ],
      "exclude": ["intern", "student", "seeking", "open to work", "freelance recruiter"]
    },
    "seniority": ["c_suite", "founder", "owner", "partner", "vp", "director", "head", "manager"],
    "departments": ["Sales", "Marketing", "Operations"],
    "excludeCompanies": [
      "linkfinderai.com", "apollo.io", "zoominfo", "lusha", "cognism", "clay.com",
      "instantly.ai", "smartlead", "lemlist"
    ],
    "companySize": { "min": 11, "max": 500 }
  },
  "sources": [
    {
      "id": "competitor-post",
      "kind": "linkedin_post_reactions",
      "label": "Reactions on a competitor's post",
      "input": "https://www.linkedin.com/posts/REPLACE-WITH-A-RECENT-POST",
      "weight": 3,
      "maxItems": 150
    },
    {
      "id": "crm-pain-post",
      "kind": "linkedin_post_reactions",
      "label": "Reactions on a 'our CRM data is a mess' post",
      "input": "https://www.linkedin.com/posts/REPLACE-WITH-A-RECENT-POST",
      "weight": 2,
      "maxItems": 100
    },
    {
      "id": "hubspot-partners",
      "kind": "company_employees",
      "by": "domain",
      "label": "Sales leaders at a named target account",
      "input": "hubspot.com",
      "department": "Sales",
      "seniority": "Director",
      "weight": 1,
      "maxItems": 25
    }
  ],
  "enrich": {
    "email": true,
    "phone": false,
    "minScore": 4,
    "maxPerRun": 40
  },
  "budget": {
    "maxCreditsPerRun": 1200
  }
}
