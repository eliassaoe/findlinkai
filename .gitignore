# Claude Code local tooling state (settings, background-agent worktrees) — never project content.
# Skills are the exception: they are project content, they only load from this path, and
# an ignored skill is one that does not survive a fresh checkout.
.claude/*
!.claude/skills/

# Dependencies — never committed. A committed node_modules broke the GitHub Pages
# build: Jekyll renders every .md it finds, and balanced-match/README.md contains
# text Liquid cannot parse, which failed the build for the whole site.
node_modules/

# Names one specific Apps Script project, not something every checkout wants.
.clasp.json
