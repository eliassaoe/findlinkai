{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["ES2019", "ES2020", "ES2022.Error"],
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["credentials/**/*.ts", "nodes/**/*.ts"]
}
