{
  "name": "n8n-nodes-linkfinderai",
  "version": "0.1.0",
  "description": "n8n community node for LinkFinder AI — enrich leads, companies, LinkedIn profiles/companies/posts and Instagram profiles from any n8n workflow.",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "homepage": "https://linkfinderai.com/integrations",
  "author": {
    "name": "LinkFinder AI",
    "email": "support@linkfinderai.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eliassaoe/findlinkai.git",
    "directory": "n8n-nodes-linkfinderai"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "lint": "eslint nodes credentials --ext .ts"
  },
  "files": [
    "dist",
    "index.js"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/LinkFinderAiApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/LinkFinderAi/LinkFinderAi.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.60.0",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=18.10"
  }
}
